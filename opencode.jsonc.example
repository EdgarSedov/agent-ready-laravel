{
  // Copy this file to `opencode.jsonc` when you want project-local OpenCode settings.
  // Keep the live file ignored so personal preferences stay local.
  // Shared repo instructions belong in `AGENTS.md`.
  // Machine-specific reminders belong in `AGENTS.local.md`.
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "AGENTS.local.md"
  ]

