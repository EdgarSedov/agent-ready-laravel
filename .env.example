APP_NAME="Agent Ready Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://app.localhost
APP_DOMAIN=app.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

APP_SLUG=agent-ready-laravel
CHECKOUT_SLUG=agent-ready-laravel
CHECKOUT_ID=main
COMPOSE_PROJECT_NAME=agent-ready-laravel

VITE_DOMAIN=vite.app.localhost
VITE_PORT=5173
# AGENT_READY_OPTIONAL_HOST_VITE: add LOCAL_VITE_URL=http://localhost:5173 if
# you switch back to a host-run Vite workflow behind shared Traefik.

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=agent_ready_laravel
DB_TEST_DATABASE=agent_ready_laravel_test
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SHARED_SERVICES_NETWORK=agent-ready-laravel-shared
SHARED_PGSQL_CONTAINER=agent-ready-laravel-pgsql
SHARED_REDIS_CONTAINER=agent-ready-laravel-redis
SHARED_MAILPIT_CONTAINER=agent-ready-laravel-mailpit
FORWARD_DB_PORT=54320
FORWARD_REDIS_PORT=63790
FORWARD_MAILPIT_SMTP_PORT=10250
FORWARD_MAILPIT_DASHBOARD_PORT=8025

WWWUSER=1000
WWWGROUP=1000

# SHARED_TRAEFIK_PATH=../shared-traefik
# Relative paths are resolved from the primary checkout, so copied worktrees keep working.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
